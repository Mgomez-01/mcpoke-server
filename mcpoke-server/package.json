{
  "name": "mcpoke-server",
  "version": "0.1.0",
  "description": "A Pokémon information server using Model Context Protocol",
  "private": true,
  "type": "module",
  "bin": {
    "mcpoke-server": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node --input-type=module -e \"import fs from 'fs'; fs.chmodSync('build/index.js', '755');\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "debug": "node --inspect build/index.js",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "sprites:clear": "node build/utils/images/clear-cache.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "0.6.0",
    "axios": "^1.6.7",
    "node-cache": "^5.1.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3"
  }
}
